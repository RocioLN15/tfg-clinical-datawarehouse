    <DTS:Executable
      DTS:refId="Package\Carga AdmittedToICU"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Tarea Flujo de datos"
      DTS:DTSID="{A277C55F-9DBE-4EBC-86CB-C78561337991}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Carga AdmittedToICU"
      DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:Variables />
      <DTS:ObjectData>
        <pipeline
          version="1">
          <components>
            <component
              refId="Package\Carga AdmittedToICU\AdmittedToICU en BD"
              componentClassID="Microsoft.ManagedComponentHost"
              contactInfo="Consume datos de SQL Server, OLE DB, ODBC u Oracle mediante el correspondiente proveedor de datos de .NET Framework. Se usa una instrucción Transact-SQL para definir el conjunto de resultados. Por ejemplo, se extraen datos de SQL Server con el proveedor de datos de .NET Framework para SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;4"
              description="Consume datos de SQL Server, OLE DB, ODBC u Oracle mediante el correspondiente proveedor de datos de .NET Framework. Se usa una instrucción Transact-SQL para definir el conjunto de resultados. Por ejemplo, se extraen datos de SQL Server con el proveedor de datos de .NET Framework para SQL Server."
              name="AdmittedToICU en BD"
              usesDispositions="true"
              version="4">
              <properties>
                <property
                  dataType="System.String"
                  description="Especifica la instrucción SQL utilizada por el componente para extraer datos."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT * FROM(
SELECT *
FROM (SELECT Pat.PatientUnitStayID,
			Pat.Age,
			Pat.AdmissionHeight,
			Pat.AdmissionWeight,
			Pat.DischargeWeight,
			A.Intubated,
			A.Vent,
			A.Dialysis,
			CASE 
				WHEN A.Eyes = -1 THEN NULL
				ELSE A.Eyes
			END AS Eyes,
			CASE 
				WHEN A.Motor = -1 THEN NULL
				ELSE A.Motor
			END AS Motor,
			CASE 
				WHEN A.Verbal = -1 THEN NULL
				ELSE A.Verbal
			END AS Verbal,
			CASE 
				WHEN A.Meds = -1 THEN NULL
				ELSE A.Meds
			END AS Meds,
			CASE 
				WHEN A.Urine = -1 THEN NULL
				ELSE A.Urine
			END AS Urine,
			CASE 
				WHEN A.WBC = -1 THEN NULL
				ELSE A.WBC
			END AS WBC,
			CASE 
				WHEN A.Temperature = -1 THEN NULL
				ELSE A.Temperature
			END AS Temperature,
			CASE 
				WHEN A.RespiratoryRate = -1 THEN NULL
				ELSE A.RespiratoryRate
			END AS RespiratoryRate,
			CASE 
				WHEN A.Sodium = -1 THEN NULL
				ELSE A.Sodium
			END AS Sodium,
			CASE 
				WHEN A.HeartRate = -1 THEN NULL
				ELSE A.HeartRate
			END AS HeartRate,
			CASE 
				WHEN A.MeanBP = -1 THEN NULL
				ELSE A.MeanBP
			END AS MeanBP,
			CASE 
				WHEN A.pH = -1 THEN NULL
				ELSE A.pH
			END AS pH,
			CASE 
				WHEN A.Hematocrit = -1 THEN NULL
				ELSE A.Hematocrit
			END AS Hematocrit,
			CASE 
				WHEN A.Creatinine = -1 THEN NULL
				ELSE A.Creatinine
			END AS Creatinine,
			CASE 
				WHEN A.Albumin = -1 THEN NULL
				ELSE A.Albumin
			END AS Albumin,
			CASE 
				WHEN A.paO2 = -1 THEN NULL
				ELSE A.paO2
			END AS paO2,
			CASE 
				WHEN A.pCO2 = -1 THEN NULL
				ELSE A.pCO2
			END AS pCO2,
			CASE 
				WHEN A.BUN = -1 THEN NULL
				ELSE A.BUN
			END AS BUN,
			CASE 
				WHEN A.Glucose = -1 THEN NULL
				ELSE A.Glucose
			END AS Glucose,
			CASE 
				WHEN A.Bilirubin = -1 THEN NULL
				ELSE A.Bilirubin
			END AS Bilirubin,
			CASE 
				WHEN A.FiO2 = -1 THEN NULL
				ELSE A.FiO2
			END AS FiO2,
			P.DiedInHospital,
			CASE
		                                WHEN Pat.ApacheAdmissionDx IS NULL THEN 'Unknown'
                                                                ELSE Pat.ApacheAdmissionDx 
	                                END AS AdmissionDiagnosis,
			P.ActiveTx as ActiveTreatment,
			P.ElectiveSurgery,
			P.Thrombolytics,
			P.HepaticFailure,
			P.Lymphoma,
			P.MetastaticCancer,
			P.Leukemia,
			P.Immunosuppression,
			P.Cirrhosis,
			P.Ima as IMA,
			P.MIDur as MI,
			P.oOBVentDay1 as VentApacheDay,
			P.oOBIntubDay1 as IntubApacheDay,
			P.Diabetes,
			CASE 
				WHEN P.EjectFx = -1 THEN NULL
				ELSE P.EjectFx
			END AS EjectionFraction,
			CASE 
				WHEN P.AMILocation = -1 THEN NULL
				ELSE P.AMILocation
			END AS AMILocation,

			Pat.[PatientHealthSystemStayID],
			Pat.[UnitAdmitTime24] AS AdmitHour,
                                                0 AS AdmitDay,
			Pat.[UnitDischargeTime24] AS DischargeHour,
                                                Pat.[UnitDischargeOffset] AS DischargeOffset,
			Pat.[HospitalDischargeYear] as Year,
			Pat.[WardID],
                                                CASE
		                                 WHEN Pat.[UnitAdmitSource] IS NULL THEN 'Unknown'
                                                                 ELSE Pat.[UnitAdmitSource]
	                                END AS UnitSource,
			CASE
		                                 WHEN Pat.[HospitalAdmitSource] IS NULL THEN 'Unknown'
                                                                 ELSE Pat.[HospitalAdmitSource]
	                                END AS HospitalSource,
			CASE
		                                 WHEN Pat.[HospitalDischargeStatus] IS NULL THEN 'Unknown'
                                                                 ELSE Pat.[HospitalDischargeStatus] 
	                                END AS HospitalStatus,
			CASE
		                                 WHEN Pat.[HospitalDischargeLocation] IS NULL THEN 'Unknown'
                                                                 ELSE Pat.[HospitalDischargeLocation]
	                                END AS HospitalLocation,
			CASE
		                                 WHEN Pat.[UnitDischargeStatus] IS NULL THEN 'Unknown'
		                                 ELSE Pat.[UnitDischargeStatus]
	                                END AS UnitStatus,
			CASE
		                                WHEN Pat.[UnitDischargeLocation] IS NULL THEN 'Unknown'
		                                ELSE Pat.[UnitDischargeLocation]
	                                END AS UnitLocation,
			Pat.[UnitType],
			Pat.[UnitStayType]
FROM [eICU Collaborative Research Database].[dbo].[ApacheApsVar] A,
	 [eICU Collaborative Research Database].[dbo].[ApachePredVar] P,
	 [eICU Collaborative Research Database].[dbo].[Patient] Pat
WHERE A.PatientUnitStayID = P.PatientUnitStayID AND P.PatientUnitStayID = Pat.PatientUnitStayID) AS Fact1

LEFT JOIN
(SELECT R.PatientUnitStayID Pat1,
		CASE 
			WHEN R.AcutePhysiologyScore = -1 THEN NULL
			ELSE R.AcutePhysiologyScore
		END AS APS,
		CASE 
			WHEN R.ApacheScore = -1 THEN NULL
			ELSE R.ApacheScore
		END AS ApacheScore
FROM [eICU Collaborative Research Database].[dbo].[ApachePatientResult] R
WHERE R.ApacheVersion = 'IVa') AS Fact2
ON Fact1.PatientUnitStayID = Fact2.Pat1

LEFT JOIN
(SELECT [PatientUnitStayID] Pat2,
        [PhysicalExamText]
FROM [eICU Collaborative Research Database].[dbo].[PhysicalExam]
WHERE [PhysicalExamText] = 'Performed - Structured'
   OR ([PhysicalExamText] = 'Not Performed'
       AND [PatientUnitStayID] NOT IN (SELECT [PatientUnitStayID]
                                       FROM [eICU Collaborative Research Database].[dbo].[PhysicalExam]
                                       WHERE [PhysicalExamText] = 'Performed - Structured'))
GROUP BY [PatientUnitStayID]
        ,[PhysicalExamText]) AS Fact3
ON Fact1.PatientUnitStayID = Fact3.Pat2

LEFT JOIN
(SELECT [PatientUnitStayID] Pat3
      ,[PastHistoryValue]
  FROM [eICU Collaborative Research Database].[dbo].[PastHistory]
  WHERE [PastHistoryValue] = 'No Health Problems' OR [PastHistoryValue] = 'Not Obtainable'
		  OR ([PastHistoryValue] = 'Not Performed' AND [PatientUnitStayID] NOT IN (SELECT [PatientUnitStayID]
                                       FROM [eICU Collaborative Research Database].[dbo].[PastHistory]
                                       WHERE [PastHistoryValue] = 'Performed'))
		  OR ([PastHistoryValue] = 'Performed' AND [PatientUnitStayID] NOT IN (SELECT [PatientUnitStayID]
                                       FROM [eICU Collaborative Research Database].[dbo].[PastHistory]
                                       WHERE [PastHistoryValue] = 'No Health Problems' OR [PastHistoryValue] = 'Not Obtainable'))
  GROUP BY [PatientUnitStayID]
      ,[PastHistoryValue]) AS Fact4
ON Fact1.PatientUnitStayID = Fact4.Pat3) AS Hecho
WHERE NOT([APS] IS NULL AND [ApacheScore] IS NULL AND
	  Eyes IS NULL AND Motor IS NULL AND Verbal IS NULL AND Meds IS NULL AND
      Urine IS NULL AND WBC IS NULL AND Temperature IS NULL AND RespiratoryRate IS NULL AND
	  Sodium IS NULL AND MeanBP IS NULL AND pH IS NULL AND Hematocrit IS NULL AND
      Creatinine IS NULL AND Albumin IS NULL AND paO2 IS NULL AND pCO2 IS NULL AND BUN IS NULL AND
	  Glucose IS NULL AND Bilirubin IS NULL AND FiO2 IS NULL)</property>
                <property
                  dataType="System.Int32"
                  description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                  name="CommandTimeout">30</property>
                <property
                  dataType="System.Boolean"
                  description="Indica si se debe permitir que columnas externas que no sean de cadenas se conviertan implícitamente en cadenas en las columnas de salida."
                  name="AllowImplicitStringConversion">true</property>
                <property
