                  description="Especifica la instrucción SQL utilizada por el componente para extraer datos."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT Offset, AdmitHour, DischargeHour, Year
FROM (
-- AdmitTime
SELECT 0 AS Offset
      ,[UnitAdmitTime24] AdmitHour
	  ,NULL DischargeHour
      ,[HospitalDischargeYear] Year
FROM [eICU Collaborative Research Database].[dbo].[Patient]

UNION

-- DischargeTime
SELECT [UnitDischargeOffset] AS Offset
      ,[UnitAdmitTime24] AdmitHour
	  ,[UnitDischargeTime24] DischargeHour
      ,[HospitalDischargeYear] Year
FROM [eICU Collaborative Research Database].[dbo].[Patient]

UNION

-- VMTime
SELECT [ObservationOffset] AS Offset
	  ,P.[UnitAdmitTime24] AdmitHour
	  ,NULL DischargeHour
	  ,P.[HospitalDischargeYear] AS Year
  FROM [eICU Collaborative Research Database].[dbo].[VitalPeriodic] VM, [eICU Collaborative Research Database].[dbo].[Patient] P
  WHERE VM.[PatientUnitStayID] = P.[PatientUnitStayID] AND NOT([HeartRate] IS NULL
	AND [Respiration] IS NULL
	AND [saO2] IS NULL)
 AND [ObservationOffset] &gt;= 0

UNION

-- BPTime
SELECT [ObservationOffset] AS Offset
	  ,P.[UnitAdmitTime24] AdmitHour
	  ,NULL DischargeHour
	  ,P.[HospitalDischargeYear] AS Year
FROM [eICU Collaborative Research Database].[dbo].[VitalAperiodic] BP, [eICU Collaborative Research Database].[dbo].[Patient] P
WHERE BP.[PatientUnitStayID] = P.[PatientUnitStayID] AND NOT([NonInvasiveSystolic] IS NULL
	AND [NonInvasiveDiastolic] IS NULL
	AND [NonInvasiveMean] IS NULL)
 AND [ObservationOffset] &gt;= 0
) AS T_Temporal
ORDER BY Year, DischargeHour, AdmitHour, Offset</property>
                <property
                  dataType="System.Int32"
